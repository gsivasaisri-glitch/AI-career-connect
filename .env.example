# AI Career Connect — Environment Variables
# ============================================
# WHY THIS FILE EXISTS:
#     Template for your .env file.
#     Copy this to .env and fill in your actual values:
#         copy .env.example .env
#
#     The .env file stores SECRETS (API keys, passwords)
#     that should NEVER be committed to Git.
#     python-dotenv reads this file automatically.

# Flask secret key — used for session encryption and CSRF tokens
# Generate a strong one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# Mistral AI API key — get yours from https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here

# Mistral model to use (options: mistral-small-latest, mistral-medium-latest, mistral-large-latest)
MISTRAL_MODEL=mistral-small-latest
